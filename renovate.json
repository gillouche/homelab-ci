{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        ":prHourlyLimitNone",
        ":prConcurrentLimitNone"
    ],
    "platformAutomerge": true,
    "packageRules": [
        {
            "matchUpdateTypes": [
                "minor",
                "patch",
                "pin",
                "digest"
            ],
            "automerge": true
        }
    ],
    "enabledManagers": [
        "pep621",
        "github-actions",
        "pre-commit",
        "regex"
    ],
    "lockFileMaintenance": {
        "enabled": true,
        "automerge": true
    }
}
